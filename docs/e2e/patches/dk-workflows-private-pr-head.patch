+    def test_private_pr_head_identity_uses_explicit_head_owner(self):
+        binpath = self.base / 'private-gh-bin'; binpath.mkdir()
+        metadata_file = self.base / 'private-pr.json'
+        fake = binpath / 'gh'
+        fake.write_text("#!/usr/bin/env python3\nimport json,os,sys\nfrom pathlib import Path\nif sys.argv[1:3]==['pr','view']:\n assert 'headRepositoryOwner' in sys.argv[-1]\n print(Path(os.environ['DK_TEST_PRIVATE_PR_METADATA']).read_text())\nelse:\n print(json.dumps({'isFork':False}))\n")
+        fake.chmod(0o755)
+        self.env['PATH'] = str(binpath) + os.pathsep + self.env['PATH']
+        self.env['DK_TEST_PRIVATE_PR_METADATA'] = str(metadata_file)
+        cmd('git', '-C', str(self.repo), 'remote', 'add', 'origin', 'https://github.com/fork/repo.git')
+        configured = self.runcli('reviewers', 'set', 'dk-pr-read-comments')
+        self.assertEqual(configured.returncode, 0, configured.stderr)
+        upstream = self.base / 'private-base'; upstream.mkdir()
+        cmd('git', 'init', '-q', str(upstream))
+        cmd('git', '-C', str(upstream), 'remote', 'add', 'origin', 'https://github.com/base/repo.git')
+        pr = 'https://github.com/base/repo/pull/7'
+        for head in [{'name': 'repo', 'nameWithOwner': ''}, {'name': 'repo'}, {'nameWithOwner': 'fork/repo'}]:
+            with self.subTest(head=head):
+                metadata_file.write_text(json.dumps({'url': pr, 'headRepository': head, 'headRepositoryOwner': {'login': 'fork'}}))
+                result = self.runcli('--pr', pr, 'reviewers', 'list', repo=upstream)
+                self.assertEqual(result.returncode, 0, result.stderr)
+                self.assertEqual(json.loads(result.stdout), json.loads(self.runcli('reviewers', 'list').stdout))
+        for head, owner in [(None, {'login': 'fork'}), ({'name': 'repo'}, {}), ({'name': 'repo'}, {'login': 'fork/escape'})]:
+            with self.subTest(head=head, owner=owner):
+                metadata_file.write_text(json.dumps({'url': pr, 'headRepository': head, 'headRepositoryOwner': owner}))
+                result = self.runcli('--pr', pr, 'reviewers', 'list', repo=upstream)
+                self.assertNotEqual(result.returncode, 0)
+                self.assertEqual(result.stdout, '')
+
